{
  "name": "gyeongju-trip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build --base ./ --outDir ../gyeongju --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "bash tests/e2e/run.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.23",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
